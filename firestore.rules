rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 共通ヘルパー ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 閲覧者が対象ユーザーをフォロー済みか確認
    function isFollowerOf(targetUid) {
      let followId = request.auth.uid + '_' + targetUid;
      return exists(/databases/$(database)/documents/follows/$(followId));
    }

    // 投稿データ(post)を渡して、閲覧者が読める投稿かどうかを判定する
    //  - 投稿者本人 → 常に読める
    //  - visibility == 'public' → サインイン済みなら誰でも読める
    //  - visibility == 'followers' もしくは未設定 → フォロワーのみ読める
    //  - visibility == 'private'（それ以外の値含む） → 投稿者本人のみ
    function canReadPostData(post) {
      return post.userId == request.auth.uid ||
        post.visibility == 'public' ||
        (
          (!('visibility' in post) || post.visibility == 'followers') &&
          isFollowerOf(post.userId)
        );
    }

    // ─── users コレクション ───────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().contains('followersCount') ||
          request.resource.data.followersCount == resource.data.get('followersCount', 0) + 1 ||
          request.resource.data.followersCount == resource.data.get('followersCount', 0) - 1
        ) && (
          !request.resource.data.diff(resource.data).affectedKeys().contains('followingCount') ||
          request.resource.data.followingCount == resource.data.get('followingCount', 0) + 1 ||
          request.resource.data.followingCount == resource.data.get('followingCount', 0) - 1
        )
      );
      allow delete: if false;

      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isSignedIn();
      }

      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid) || isOwner(targetUid);
      }

      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid) || isOwner(followerUid);
      }
    }

    // ─── posts コレクション ───────────────────────────────────────────
    match /posts/{postId} {
      // 投稿の公開範囲(visibility)を実際に強制する:
      //  - public          → サインイン済みなら誰でも閲覧可
      //  - followers / 未設定 → 投稿者本人 + 投稿者をフォロー済みの人のみ
      //  - private         → 投稿者本人のみ
      allow read: if isSignedIn() && canReadPostData(resource.data);

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isValidLikeToggle()
      );

      function isValidLikeToggle() {
        let beforeIds = resource.data.get('likedUserIds', []);
        let afterIds = request.resource.data.get('likedUserIds', []);
        let uid = request.auth.uid;

        return isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedUserIds', 'likesCount']) &&
          request.resource.data.likesCount == afterIds.size() &&
          (
            (afterIds.size() == beforeIds.size() + 1 &&
              afterIds.toSet().difference(beforeIds.toSet()) == [uid].toSet()) ||
            (afterIds.size() == beforeIds.size() - 1 &&
              beforeIds.toSet().difference(afterIds.toSet()) == [uid].toSet())
          );
      }

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        // コメントも親投稿と同じ公開範囲ルールに従う（親投稿を読めない人はコメントも読めない）
        allow read: if isSignedIn() && canReadPostData(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // ─── calendarEvents コレクション ──────────────────────────────────
    match /calendarEvents/{eventId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ─── weeklyGoals コレクション ─────────────────────────────────────
    match /weeklyGoals/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ─── followRequests コレクション ──────────────────────────────────
    match /followRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ─── follows コレクション ─────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.followerId == request.auth.uid ||
        request.resource.data.followingId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followingId == request.auth.uid
      );
      allow update: if false;
    }
  }
}
